# Копія сайту на *.run.app не має потрапляти в індекс — інакше Google бачить
# два однакові сайти (duplicate content) і може ранжувати службовий домен.
map $host $robots_tag {
    default          "noindex, nofollow";
    synapse.tel      "all";
    www.synapse.tel  "all";
}

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Robots-Tag $robots_tag always;

    # Жодного з цих заголовків прод не віддавав (перевірено на synapse.tel).
    # CSP свідомо немає: сторінка тягне Google OAuth, аватарки Google і
    # вебсокет до API, тож вгадана політика зламала б сайт — її треба писати
    # окремо, звіряючись із реальними запитами.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Ассети мають хеш у назві файлу — можна кешувати назовсім.
    location /assets/ {
        expires 1y;
        # add_header на рівні location скасовує всі успадковані, тож потрібні
        # тут ще раз — інакше js і css їдуть зовсім без заголовків.
        add_header Cache-Control "public, immutable";
        add_header X-Robots-Tag $robots_tag always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # index.html не має кешуватись: імені без хеша, а всередині — посилання на
    # поточний бандл. Без явного заголовка браузер кешує оболонку евристично і
    # після деплою просить уже видалений /assets/index-<старий хеш>.js — білий
    # екран. Заголовки дублюються з тієї ж причини, що й у /assets/.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag $robots_tag always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # SPA-фолбек віддавав 200 навіть на /.env та /.git/config — сканери
    # трактують це як "знайдено". Віддаємо 404, як і має бути.
    location ~ /\.(?!well-known) {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

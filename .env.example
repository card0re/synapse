# Copy to .env and fill in. Never commit the filled-in file.

# --- required ---
DATABASE_URL=postgres://root:devpassword@localhost:5432/skillswap?sslmode=disable
JWT_SECRET_KEY=            # 32+ random bytes, e.g. `openssl rand -hex 32`. No default: the app refuses to boot without it.
GOOGLE_CLIENT_ID=          # OAuth client ID for the web app; id_token `aud` is checked against it

# --- optional ---
PORT=8080
CORS_ORIGINS=http://localhost:5173    # comma-separated; a malformed value panics at boot
REDIS_ADDR=                # leave empty to run without caching (supported, logs a warning)
REDIS_PASSWORD=

# --- integrations ---
TELEGRAM_BOT_TOKEN=        # @BotFather
GEMINI_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=             # Gmail app password, not the account password

# Google Calendar/Meet service credentials (separate OAuth client from GOOGLE_CLIENT_ID)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
